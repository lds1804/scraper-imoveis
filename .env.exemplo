# Chave da API da DeepSeek para a análise visual das fotos.
#
# Copie este arquivo para `.env` e preencha:
#     copy .env.exemplo .env
#
# O `.env` está no .gitignore e nunca vai para o repositório.
# A chave também pode vir da variável de ambiente DEEPSEEK_API_KEY,
# que tem prioridade sobre este arquivo.

DEEPSEEK_API_KEY=sk-...
